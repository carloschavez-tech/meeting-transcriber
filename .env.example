# API key de OpenRouter (openrouter.ai/settings/keys) - usada solo para generar el informe
OPENROUTER_API_KEY=

# Nombre del dispositivo de entrada a grabar (debe existir tras instalar BlackHole)
AUDIO_DEVICE_NAME=BlackHole 2ch

# Tamaño del modelo Whisper: tiny, base, small, medium, large-v3
WHISPER_MODEL=medium

# Idioma de la transcripción (código ISO, ej. "es", "en"). Vacío = autodetectar.
WHISPER_LANGUAGE=es

# --- Envío automático por email (opcional) ---
# Poné EMAIL_ENABLED=true para que el informe y la transcripción se envíen
# por correo automáticamente al terminar cada reunión. Ver README.md para
# cómo generar una "contraseña de aplicación" de Gmail.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=
EMAIL_APP_PASSWORD=
# Uno o más destinatarios separados por coma
EMAIL_TO=

# --- Sugerencias en vivo durante la reunión (opcional) ---
# Mientras se graba, transcribe fragmentos cortos y le pide a la IA preguntas
# de requerimientos para hacerle al cliente, mostradas en la app en vivo.
# No afecta la transcripción/informe final, que sigue usando el audio completo.
LIVE_SUGGESTIONS_ENABLED=true
# Cada cuántos segundos se actualizan las sugerencias
LIVE_CHUNK_SECONDS=45
# Modelo Whisper para los fragmentos en vivo. "medium" da mejores sugerencias
# pero es más lento; "small" o "base" son más rápidos pero bastante peores.
LIVE_WHISPER_MODEL=medium
